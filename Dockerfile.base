ARG JRE_VERSION="25"
# Ubuntu 26.04 provides the OpenSSL symbols required by Python runtimes copied from Debian Trixie.
FROM eclipse-temurin:${JRE_VERSION}-jre-resolute

ARG UV_VERSION="0.13.5"
ARG WITH_PYTHON="false"

# Ubuntu 24.04+ bases (eclipse-temurin:*-jre) ship a default `ubuntu` user on
# UID/GID 1000, which would push our `useradd` to 1001. Pin kestra to 1000 so
# deployments that assume it (Helm rootless DinD socket group, fsGroup, existing
# PVC ownership) keep working.
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupadd -g 1000 kestra && \
    useradd -u 1000 -g 1000 -m kestra

WORKDIR /app

COPY dev-tools/verify-brotli.sh /tmp/verify-brotli.sh
RUN apt-get update -y && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends curl jattach libbrotli1 && \
    sh /tmp/verify-brotli.sh && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh && \
    mv /root/.local/bin/uv /bin && \
    mv /root/.local/bin/uvx /bin

RUN if [ "$WITH_PYTHON" = "true" ]; then \
        apt-get update -y && \
        apt-get install -y --no-install-recommends python3 python-is-python3 python3-pip && \
        apt-get install -y --no-install-recommends build-essential cmake python3-dev && \
        uv venv /app/.venv && \
        uv pip install --python /app/.venv/bin/python kestra 'certifi>=2026.10.19' && \
        apt-get purge -y --auto-remove build-essential cmake python3-dev && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY dev-tools/distrust-emudhra.sh /tmp/distrust-emudhra.sh
RUN sh /tmp/distrust-emudhra.sh && rm /tmp/distrust-emudhra.sh
